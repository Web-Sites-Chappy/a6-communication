# HubSpot Private App token (Settings → Integrations → Private Apps)
# Required scope: crm.objects.contacts.write
HUBSPOT_PRIVATE_APP_TOKEN=

# Pexels API key (https://www.pexels.com/api/) — used only by scripts/fetch-pexels.mjs
# to source stock photos locally, not called at runtime by the site.
PEXELS_API_KEY=

# Hostinger API token (hPanel → API : https://hpanel.hostinger.com/api)
# Used only by scripts/hostinger-dns.mjs to manage DNS records, not called at runtime by the site.
HOSTINGER_API_TOKEN=

# Optional public URL for the original/high-quality hero video on Cloudflare R2/Stream or AWS CloudFront.
# The CDN should support HTTP Range requests and return Content-Type: video/mp4.
NEXT_PUBLIC_HERO_VIDEO_URL=
